  <property name="styleSheet">
   <string notr="true">
/* ===== Global ===== */
QMainWindow, QWidget { background:#f6f7f9; color:#111; font-family:&quot;Segoe UI&quot;,&quot;Malgun Gothic&quot;; }
QLabel { color:#111; }
QFrame#sidebar { background:#ffffff; border-right:1px solid #e5e7eb; }
QFrame#headerBar { background:#ffffff; border-bottom:1px solid #e5e7eb; }
QFrame#contentFrame { background:transparent; }
QFrame#card { background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; }
QGroupBox {
  background:#ffffff;
  border:1px solid #e5e7eb;
  border-radius:10px;
  margin-top:12px;
  padding:10px;
}
QGroupBox::title { subcontrol-origin: margin; left:12px; padding:0 6px; color:#111; font-weight:600; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
  background:#ffffff; border:1px solid #d1d5db; border-radius:6px; padding:6px 8px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border:1px solid #3b82f6; }
QPlainTextEdit, QTextEdit {
  background:#ffffff; border:1px solid #d1d5db; border-radius:8px; padding:8px;
}
QTableWidget {
  background:#ffffff; border:1px solid #e5e7eb; border-radius:10px;
  gridline-color:#eef2f7;
}
QHeaderView::section {
  background:#f3f4f6; border:0px; border-right:1px solid #e5e7eb;
  padding:8px; font-weight:600; color:#111;
}
QPushButton {
  background:#ffffff; border:1px solid #d1d5db; border-radius:8px; padding:7px 12px;
}
QPushButton:hover { border:1px solid #93c5fd; }
QPushButton:pressed { background:#f3f4f6; }

QPushButton[cssClass=&quot;primary&quot;] {
  background:#2563eb; color:#ffffff; border:1px solid #2563eb;
}
QPushButton[cssClass=&quot;primary&quot;]:hover { background:#1d4ed8; border:1px solid #1d4ed8; }
QPushButton[cssClass=&quot;danger&quot;] {
  background:#ef4444; color:#ffffff; border:1px solid #ef4444;
}
QPushButton[cssClass=&quot;danger&quot;]:hover { background:#dc2626; border:1px solid #dc2626; }

QPushButton#navBtn {
  text-align:left;
  padding:10px 12px;
  border:0px;
  border-radius:10px;
  background:transparent;
  color:#111;
}
QPushButton#navBtn:hover { background:#f3f4f6; }
QPushButton#navBtn:checked { background:#dbeafe; color:#1d4ed8; font-weight:700; }

QProgressBar {
  border:1px solid #d1d5db; border-radius:8px; text-align:center; background:#ffffff; height:18px;
}
QProgressBar::chunk { background:#60a5fa; border-radius:8px; }
